# Nexora AI — variáveis de ambiente
# Copie para .env.local (local) e cadastre as mesmas na Vercel (Settings > Environment Variables).
# NUNCA coloque a service role key aqui: este pacote não a utiliza.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon / publishable). É segura para o navegador porque o acesso é protegido por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app, sem barra final. Local: http://localhost:3000 — Produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=
